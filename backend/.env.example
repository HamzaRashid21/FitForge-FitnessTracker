# FitForge Backend Environment Configuration
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to source control.

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security and CORS
# Comma-separated list of allowed origins (e.g., http://localhost:5173,https://yourdomain.com)
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (MongoDB)
# Local instance default: mongodb://127.0.0.1:27017/fitforge_dev
# MongoDB Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fitforge_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fitforge_dev
MONGODB_DEBUG=false

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=fitforge_dev_jwt_access_secret_key_32charsmin!
JWT_REFRESH_SECRET=fitforge_dev_jwt_refresh_secret_key_32charsmin!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (SMTP)
# If left empty, emails will log verification/reset URLs to the console for development testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FitForge <no-reply@fitforge.com>
